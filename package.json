{
  "name": "cinematic-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first personal music player for Android. Cinematic frontend foundation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:open": "cap open android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
