{
  "name": "cinematic-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android music app based on the GPL-3.0 InterTune project, with a retained Vite prototype",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:debug": "cd android && ./gradlew assembleCoreDebug",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify": "npm test && npm run build",
    "android:test": "cd android && ./gradlew testCoreDebugUnitTest"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
