<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) rules, referenced by android:dataExtractionRules.
  V1 policy: nothing leaves the device automatically, neither through cloud
  backup nor device-to-device transfer. Every documented domain is excluded
  from both sections, including the device-protected-storage domains
  (device_*), which only exist in this file format (the pre-Android-12
  full-backup-content format has no device_* domains).
  This app does not use device-protected storage (no directBootAware
  components), so the device_* rules are defence in depth.
  There is deliberately no <include> element anywhere in this file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
